{
  "name": "work-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "architecture:check": "architecture-check",
    "lint": "architecture-check",
    "format": "oxfmt",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm architecture:check && pnpm test",
    "dev:server": "WORK_OS_PORT=${WORK_OS_PORT:-4311} WORK_OS_DATA_DIR=${WORK_OS_DATA_DIR:-$HOME/.work-os/dev-server} WORK_OS_PUBLIC_ORIGIN=${WORK_OS_PUBLIC_ORIGIN:-http://localhost:5173} node --watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @work-os/web dev",
    "dev:runner": "WORK_OS_RUNNER_DATA_DIR=${WORK_OS_RUNNER_DATA_DIR:-$HOME/.work-os/dev-runner} node apps/runner/src/main.ts",
    "api-types": "scripts/generate-api-types.sh",
    "egress:image": "pnpm --filter @work-os/egress-gateway build && docker build --tag work-os/egress-gateway:local ${WORK_OS_NODE_IMAGE:+--build-arg NODE_IMAGE=$WORK_OS_NODE_IMAGE} apps/egress-gateway",
    "smoke": "scripts/smoke-host.sh",
    "web:build": "pnpm --filter @work-os/web build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "architecture-rules": "link:../architecture-rules",
    "oxfmt": "0.68.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
