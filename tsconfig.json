{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/runner/src/**/*.ts",
    "apps/egress-gateway/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "bundled/*/src/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "packages/db/drizzle.config.ts",
    "apps/egress-gateway/vite.config.ts",
    "apps/web/vite.config.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "packages/design-tokens/**", "architecture.config.ts"]
}
